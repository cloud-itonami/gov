;; shadow-cljs build for the gov appview UI (gov-mcp-component).
;; Mirrors orgs/cloud-itonami/app-itonami/shadow-cljs.edn:
;; CLJS + reagent on kotoba-ui.core + appkit.core (murakumo-studio構成).
{:deps {:aliases [:cljs]}
 :nrepl {:port 9632}

 :builds
 {:app
  {:target :browser
   :output-dir "appview/gov-mcp-component/web/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn cloud-itonami.gov-mcp-component.desktop/init!}}}}}
